{
  "manifest_version": 3,
  "name": "Anti-Fingerprint",
  "version": "1.0.0",
  "description": "Normalizes common automation fingerprint leaks for browser automation learning.",
  "permissions": [],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}